# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The chargeback responder picks a provider from whichever key is present. With
# neither, it drafts packets from templates and flags them degraded - nothing else
# in the system changes.
GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Override the model if you want a cheaper or newer tier.
# FINGUARD_LLM_MODEL=

# Where the API listens. 8080 is popular; change it if something else has it.
# FINGUARD_PORT=8080

# Enables the endpoint that disables the model so the degradation ladder can be
# demonstrated live. Never enable this in a deployment that matters.
# FINGUARD_ENABLE_CHAOS=1
